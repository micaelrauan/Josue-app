{
  "name": "josue-app",
  "productName": "Josué App",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node web.js",
    "dev": "node --watch web.js",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev-desktop.ps1",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-desktop.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-installer.ps1",
    "build:mac": "bash tools/build-mac.sh",
    "clean:cache": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/clean-build-cache.ps1",
    "test": "node test/run.js"
  }
}
